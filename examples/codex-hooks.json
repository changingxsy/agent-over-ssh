{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash /path/to/agent-over-ssh/hooks/rdev-hook.sh session codex", "timeout": 20 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash /path/to/agent-over-ssh/hooks/rdev-hook.sh prompt codex", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "bash /path/to/agent-over-ssh/hooks/rdev-hook.sh guard codex", "timeout": 10 } ] }
    ]
  }
}
